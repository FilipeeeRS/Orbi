# Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (nunca expor no navegador). Usada só no servidor para gravar o catálogo.
SUPABASE_SECRET_KEY=sb_secret_...

# TMDB: themoviedb.org → Settings → API (aceita a API Key v3 ou o Read Access Token v4)
TMDB_API_KEY=
