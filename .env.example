# Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (nunca expor no navegador). Usada só no servidor para gravar o catálogo.
SUPABASE_SECRET_KEY=sb_secret_...

# TMDB: themoviedb.org → Settings → API (aceita a API Key v3 ou o Read Access Token v4)
TMDB_API_KEY=

# Testes automáticos (npm run test:e2e). Opcional: uma conta SÓ DE TESTE no Orbi, em português,
# para os testes de quem está logado (notificações, nota, listas...). Sem ela, só rodam os de visitante.
E2E_EMAIL=
E2E_PASSWORD=
# Endereço do site testado (padrão: http://localhost:3000)
PLAYWRIGHT_BASE_URL=
